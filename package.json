{
  "name": "where-it-all-is",
  "version": "0.1.0",
  "description": "Where It All Is — ADHD-friendly offline budget app",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode app",
    "build:demo": "vite build --mode demo",
    "build:all": "npm run build && npm run build:demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "audit": "playwright test -c playwright.audit.config.ts",
    "sheets": "esbuild scripts/make-debt-sheets.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/make-debt-sheets.mjs && node node_modules/.cache/make-debt-sheets.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:pdf": "node scripts/build-pdf.mjs",
    "package": "npm run build:all && npm run build:site && npm run build:pdf"
  },
  "author": "Hamza",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "preact": "^11.0.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "fake-indexeddb": "^6.2.5",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "private": true
}
